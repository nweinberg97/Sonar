# Local SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Password for the creator side (/feedback, /responses, /insights, /settings).
# Leave blank and one is generated for you on first run. Respondent links stay open.
SONAR_PASSWORD=

# ---------------------------------------------------------------------------
# Speech to text
#   local  = open-source Whisper running on this server. Free, no key, audio
#            never leaves the machine. (default)
#   mock   = sample transcripts, for offline demos
#   openai | groq = hosted Whisper (needs TRANSCRIPTION_API_KEY)
# ---------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=local
# TRANSCRIPTION_MODEL=Xenova/whisper-base.en   # faster: Xenova/whisper-tiny.en, better: Xenova/whisper-small.en
# TRANSCRIPTION_MODEL_REVISION=main            # pin to a commit hash for reproducible downloads
# TRANSCRIPTION_OFFLINE=false                  # true = never download, use ./.models only
# TRANSCRIPTION_API_KEY=

# ---------------------------------------------------------------------------
# Insights (turning each transcript into sentiment, themes, requests, summary)
#   ollama = an open-source model running on this machine via Ollama. Free,
#            no key, nothing leaves the server. (default)
#   mock   = Sonar's built-in rule-based extractor. Also the automatic
#            fallback whenever the model isn't available.
#   anthropic | openai | groq = hosted models (needs AI_API_KEY)
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama
# Other good small models: qwen2.5:3b, or llama3.2:1b for more speed
AI_MODEL=llama3.2:3b
# AI_API_KEY=
# AI_BASE_URL=

# Public base URL used when showing share links (defaults to the address in your browser)
# NEXT_PUBLIC_APP_URL=

# Testing tools (reset, generate sample responses) are on in development.
# Set to "true" to keep them in `npm run serve`.
SONAR_DEMO_TOOLS=true

# ---------------------------------------------------------------------------
# Integrations (optional). Nothing is ever sent automatically: you review and
# press Send on the Insights page. Restart Sonar after changing these.
# ---------------------------------------------------------------------------
# Slack: an "incoming webhook" for the channel you want (see Settings → Integrations)
# SLACK_WEBHOOK_URL=
# More channels, one per Sonar if you like (each Sonar picks one in the builder):
# SLACK_WEBHOOK_URL_TEAM_PULSE=        # shows up as #team-pulse
# Linear: Settings → Security & access → Personal API keys
# LINEAR_API_KEY=
# Which Linear team gets issues, by key or name (only needed if you have more than one)
# LINEAR_TEAM=

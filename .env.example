# Local SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Providers. Leave everything blank to run the full product in demo (mock) mode.
# ---------------------------------------------------------------------------

# Speech-to-text: mock | openai | groq
#   openai and groq both use the OpenAI-compatible /audio/transcriptions API.
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=
# Optional overrides
# TRANSCRIPTION_MODEL=whisper-1            # groq default: whisper-large-v3-turbo
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1

# Insight extraction: mock | anthropic | openai | groq
AI_PROVIDER=
AI_API_KEY=
# Optional overrides
# AI_MODEL=claude-sonnet-5-5
# AI_BASE_URL=

# Public base URL used when showing share links (defaults to the request host)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo tools (reset database, generate sample responses) are on in development.
# Set to "true" to keep them available in a production build you're user-testing.
# SONAR_DEMO_TOOLS=true

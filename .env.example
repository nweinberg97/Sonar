# Local SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Password for the creator side (/feedback, /responses, /insights, /settings).
# Leave blank and one is generated for you on first run. Respondent links stay open.
SONAR_PASSWORD=

# ---------------------------------------------------------------------------
# Speech to text
#   local  = open-source Whisper running on this server. Free, no key, audio
#            never leaves the machine. (default)
#   mock   = sample transcripts, for offline demos
#   openai | groq = hosted Whisper (needs TRANSCRIPTION_API_KEY)
# ---------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=local
# TRANSCRIPTION_MODEL=Xenova/whisper-base.en   # faster: Xenova/whisper-tiny.en, better: Xenova/whisper-small.en
# TRANSCRIPTION_MODEL_REVISION=main            # pin to a commit hash for reproducible downloads
# TRANSCRIPTION_OFFLINE=false                  # true = never download, use ./.models only
# TRANSCRIPTION_API_KEY=

# ---------------------------------------------------------------------------
# Insights
#   mock   = Sonar's built-in extractor. Free, runs here. (default)
#   ollama = an open-source model on your own machine (https://ollama.com)
#   anthropic | openai | groq = hosted models (needs AI_API_KEY)
# ---------------------------------------------------------------------------
AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=

# Public base URL used when showing share links (defaults to the address in your browser)
# NEXT_PUBLIC_APP_URL=

# Testing tools (reset, generate sample responses) are on in development.
# Set to "true" to keep them in `npm run serve`.
SONAR_DEMO_TOOLS=true

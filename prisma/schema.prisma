// Sonar — minimal schema for the voice feedback prototype.
//
// Notes
// - Timestamps are ISO-8601 strings so raw SQL stays portable and readable.
// - JSON payloads (feature_requests, key_points, synthesis) are stored as TEXT.
// - No audio is ever stored. Transcript-first, audio-ephemeral.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String            @id
  name      String
  createdAt String            @map("created_at")
  sessions  FeedbackSession[]
  themes    Theme[]

  @@map("workspaces")
}

model FeedbackSession {
  id          String       @id
  workspaceId String       @map("workspace_id")
  title       String
  description String       @default("")
  slug        String       @unique
  status      String       @default("draft") // draft | published | closed
  template    String       @default("general")
  // "questions": a list of questions, one recording each (the original flow).
  // "conversation": one main question; AI follow-ups appear when the person pauses.
  format        String     @default("questions")
  // Conversation only: what the creator wants to learn (steers the follow-ups)
  // and how long they'd like people to talk, in seconds (30–300).
  goal          String     @default("")
  targetSeconds Int        @default(60) @map("target_seconds")
  // "none" = one-off. "weekly" = a pulse: same link every week, Insights compares
  // each week with the one before. Weeks run Monday–Sunday in `timezone`.
  cadence       String     @default("none")
  timezone      String     @default("UTC")
  // Which Slack channel this Sonar posts to: "" = the default (SLACK_WEBHOOK_URL),
  // or a name from SLACK_WEBHOOK_URL_<NAME> in .env.
  slackChannel  String     @default("") @map("slack_channel")
  createdAt   String       @map("created_at")
  updatedAt   String       @map("updated_at")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questions   Question[]
  responses   Response[]
  respondents Respondent[]
  synthesis   Synthesis?
  shareItems  ShareItem[]

  @@map("feedback_sessions")
}

model Question {
  id        String          @id
  sessionId String          @map("session_id")
  position  Int
  text      String
  createdAt String          @map("created_at")
  session   FeedbackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([sessionId, position])
  @@map("questions")
}

// One anonymous person moving through one Sonar. Its id is the
// session_response_id that groups their answers. No name, no email.
model Respondent {
  id          String          @id
  sessionId   String          @map("session_id")
  startedAt   String          @map("started_at")
  completedAt String?         @map("completed_at")
  // 1 = they tapped "OK to quote me anonymously" at the end. 0 by default: never assumed.
  quoteConsent Int            @default(0) @map("quote_consent")
  session     FeedbackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses   Response[]

  @@index([sessionId])
  @@map("respondents")
}

model Response {
  id                String          @id
  sessionId         String          @map("session_id")
  questionId        String          @map("question_id")
  sessionResponseId String          @map("session_response_id")
  transcript        String
  inputMode         String          @default("voice") @map("input_mode") // voice | text
  durationMs        Int             @default(0) @map("duration_ms")
  // Conversation answers only: JSON list of what was said and each follow-up
  // shown, in order, e.g. [{"t":"speech","text":"…","atMs":0},{"t":"followup","text":"…","atMs":9000,"by":"ai"}].
  // `transcript` still holds the speech alone, so analysis works unchanged.
  segments          String?
  createdAt         String          @map("created_at")
  session           FeedbackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  respondent        Respondent      @relation(fields: [sessionResponseId], references: [id], onDelete: Cascade)
  insight           AIInsight?
  testimonial       Testimonial?

  @@index([sessionId])
  @@index([sessionResponseId])
  @@map("responses")
}

model AIInsight {
  id                   String   @id
  responseId           String   @unique @map("response_id")
  sentimentScore       Int      @map("sentiment_score")
  sentimentLabel       String   @map("sentiment_label")
  primaryTheme         String   @map("primary_theme")
  businessInefficiency String?  @map("business_inefficiency")
  featureRequests      String   @default("[]") @map("feature_requests") // JSON string[]
  keyPoints            String   @default("[]") @map("key_points") // JSON string[]
  executiveSummary     String   @map("executive_summary")
  source               String   @default("builtin") // which engine wrote it: "ollama:<model>", "builtin", "seed", …
  // The canonical theme from the library (see Theme). primary_theme keeps the model's raw label.
  themeId              String?  @map("theme_id")
  createdAt            String   @map("created_at")
  response             Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  otherThemes          InsightTheme[]

  @@index([themeId])
  @@map("ai_insights")
}

// Cached cross-response synthesis for the Insights view.
model Synthesis {
  sessionId     String          @id @map("session_id")
  responseCount Int             @map("response_count")
  data          String // JSON
  createdAt     String          @map("created_at")
  session       FeedbackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("syntheses")
}

// Things the creator sent out of Sonar (a Slack summary, a Linear issue).
// Nothing is sent without the creator reviewing it and pressing Send; this is
// the record of what went where. `id` is a key from the browser, so pressing
// Send twice can never post twice.
model ShareItem {
  id          String          @id
  sessionId   String          @map("session_id")
  kind        String // slack | linear
  source      String          @default("") // what it was made from, e.g. "request:Self-serve booking link"
  title       String          @default("")
  body        String
  status      String // sent | failed
  externalUrl String?         @map("external_url")
  error       String?
  createdAt   String          @map("created_at")
  sentAt      String?         @map("sent_at")
  session     FeedbackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("share_items")
}

// The theme library: one name per idea, shared by every Sonar in the workspace,
// so counts, weekly pulses and tickets add up. The model is asked to reuse
// these names; anything new arrives as "suggested" until the creator accepts,
// renames or merges it. Merged themes keep pointing at the theme they joined,
// so the old label keeps landing in the right place.
model Theme {
  id           String    @id
  workspaceId  String    @map("workspace_id")
  name         String
  key          String // normalised name used for matching ("Workshops" = "workshop")
  status       String    @default("active") // active | suggested | merged
  mergedIntoId String?   @map("merged_into_id")
  createdAt    String    @map("created_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("themes")
}

// Extra themes for an answer that covers more than one topic (usually a long
// conversation): it counts toward each of them as well as its main theme.
model InsightTheme {
  insightId String    @map("insight_id")
  themeId   String    @map("theme_id")
  insight   AIInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@id([insightId, themeId])
  @@index([themeId])
  @@map("insight_themes")
}

// A quote the creator approved (or turned down) for use as a testimonial.
// Only answers from respondents who gave quote consent can be approved.
// `text` may be lightly trimmed by the creator; the original stays in the response.
model Testimonial {
  id         String   @id
  responseId String   @unique @map("response_id")
  text       String
  status     String // approved | rejected
  createdAt  String   @map("created_at")
  updatedAt  String   @map("updated_at")
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("testimonials")
}

// Sonar — minimal schema for the voice feedback prototype.
//
// Notes
// - Timestamps are ISO-8601 strings so raw SQL stays portable and readable.
// - JSON payloads (feature_requests, key_points, synthesis) are stored as TEXT.
// - No audio is ever stored. Transcript-first, audio-ephemeral.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String            @id
  name      String
  createdAt String            @map("created_at")
  sessions  FeedbackSession[]

  @@map("workspaces")
}

model FeedbackSession {
  id          String       @id
  workspaceId String       @map("workspace_id")
  title       String
  description String       @default("")
  slug        String       @unique
  status      String       @default("draft") // draft | published | closed
  template    String       @default("general")
  createdAt   String       @map("created_at")
  updatedAt   String       @map("updated_at")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questions   Question[]
  responses   Response[]
  respondents Respondent[]
  synthesis   Synthesis?

  @@map("feedback_sessions")
}

model Question {
  id        String          @id
  sessionId String          @map("session_id")
  position  Int
  text      String
  createdAt String          @map("created_at")
  session   FeedbackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([sessionId, position])
  @@map("questions")
}

// One anonymous person moving through one Sonar. Its id is the
// session_response_id that groups their answers. No name, no email.
model Respondent {
  id          String          @id
  sessionId   String          @map("session_id")
  startedAt   String          @map("started_at")
  completedAt String?         @map("completed_at")
  session     FeedbackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses   Response[]

  @@index([sessionId])
  @@map("respondents")
}

model Response {
  id                String          @id
  sessionId         String          @map("session_id")
  questionId        String          @map("question_id")
  sessionResponseId String          @map("session_response_id")
  transcript        String
  inputMode         String          @default("voice") @map("input_mode") // voice | text
  durationMs        Int             @default(0) @map("duration_ms")
  createdAt         String          @map("created_at")
  session           FeedbackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  respondent        Respondent      @relation(fields: [sessionResponseId], references: [id], onDelete: Cascade)
  insight           AIInsight?

  @@index([sessionId])
  @@index([sessionResponseId])
  @@map("responses")
}

model AIInsight {
  id                   String   @id
  responseId           String   @unique @map("response_id")
  sentimentScore       Int      @map("sentiment_score")
  sentimentLabel       String   @map("sentiment_label")
  primaryTheme         String   @map("primary_theme")
  businessInefficiency String?  @map("business_inefficiency")
  featureRequests      String   @default("[]") @map("feature_requests") // JSON string[]
  keyPoints            String   @default("[]") @map("key_points") // JSON string[]
  executiveSummary     String   @map("executive_summary")
  source               String   @default("builtin") // which engine wrote it: "ollama:<model>", "builtin", "seed", …
  createdAt            String   @map("created_at")
  response             Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

// Cached cross-response synthesis for the Insights view.
model Synthesis {
  sessionId     String          @id @map("session_id")
  responseCount Int             @map("response_count")
  data          String // JSON
  createdAt     String          @map("created_at")
  session       FeedbackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("syntheses")
}
